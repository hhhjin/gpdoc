---
import ExamplePanel from "./ExamplePanel.astro";
import { pluginExamples } from "../plugin-example-config";

interface Props {
  plugin: keyof typeof pluginExamples;
}

const { plugin } = Astro.props;
const config = pluginExamples[plugin];
const collaboration = plugin.startsWith("collaboration");
---

<ExamplePanel kind="plugin" title="Interactive editor" hint={config.hint} plugin={plugin}>
  <div class="plugin-documents">
    <div class="editor-column">
      {collaboration && <div class="editor-label">Alice</div>}
      {config.actions.filter((action) => action.fields.length).map((action) => (
        <div class="plugin-fields" data-fields={action.id}>
          {action.fields.map((field) => (
            <label class="example-label">
              {field.label}
              {field.kind === "select" ? (
                <select name={field.name} data-boolean={field.boolean ? "" : undefined}>
                  {field.choices.map(([value, label]) => <option value={value}>{label}</option>)}
                </select>
              ) : field.kind === "textarea" ? (
                <textarea name={field.name} rows="5" maxlength="4000" required>{field.value}</textarea>
              ) : (
                <input
                  type={field.kind}
                  name={field.name}
                  value={field.value}
                  min={"min" in field ? field.min : undefined}
                  max={"max" in field ? field.max : undefined}
                  maxlength={field.name === "src" || field.name === "href" ? 500 : 120}
                  required={!("optional" in field && field.optional)}
                />
              )}
            </label>
          ))}
        </div>
      ))}
      <div class="example-document" data-editor role="textbox" aria-multiline="true"
        aria-label={collaboration ? "Alice's editor" : "Example editor"} aria-description={config.hint}>{config.source}</div>
    </div>
    {collaboration && <div class="editor-column">
      <div class="editor-label">Bob</div>
      <div class="example-document" data-peer role="textbox" aria-multiline="true"
        aria-label="Bob's editor" aria-description={config.hint}></div>
    </div>}
  </div>
  <dl class="editor-output" data-plugin-facts hidden></dl>
</ExamplePanel>

<style>
  .editor-column :global(.editor-toolbar) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 2px;
    min-height: 44px;
    padding: 4px 6px;
    background: var(--sl-color-bg-sidebar);
    border-block-end: 1px solid var(--sl-color-gray-5);
  }

  .editor-column :global(.editor-toolbar button) {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--sl-color-text);
    cursor: pointer;
  }

  .editor-column :global(.editor-toolbar button:hover),
  .editor-column :global(.editor-toolbar button[aria-pressed="true"]) {
    background: var(--sl-color-gray-5);
  }

  .editor-column :global(.editor-toolbar svg) {
    width: 17px;
    height: 17px;
  }

  .plugin-fields {
    padding: 0.65rem 0.85rem;
    background: var(--sl-color-bg-sidebar);
  }

  .plugin-fields,
  .plugin-documents {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
    gap: 0.65rem;
  }

  .plugin-fields label {
    min-width: 0;
  }

  .plugin-fields label:has(textarea) {
    grid-column: 1 / -1;
  }

  [hidden] {
    display: none;
  }

  textarea {
    resize: vertical;
    font-family: var(--sl-font-mono);
  }

  input[type="color"] {
    width: 3.5rem;
  }

  .editor-column {
    min-width: 0;
  }

  .editor-column + .editor-column {
    border-inline-start: 1px solid var(--sl-color-gray-5);
  }

  .editor-label {
    color: var(--sl-color-gray-2);
    font-size: 0.8125rem;
    font-weight: 600;
    padding: 0.55rem 0.85rem 0;
  }

  .editor-output {
    border-block-start: 1px solid var(--sl-color-gray-5);
    padding: 0.55rem 0.85rem;
  }

  .editor-column > .example-document {
    font-size: 1rem;
    font-weight: 400;
    background: var(--sl-color-bg);
    min-height: 7rem;
    border: 0;
    border-radius: 0;
    padding: 0.85rem;
  }

  .example-document:focus {
    outline: none;
  }

  .example-document :global(.search-match) {
    background: #ffec94;
    color: #30230b;
  }

  .example-document :global(.search-match[aria-current="true"]) {
    background: #ffb566;
    outline: 1px solid #925000;
  }

  .example-document :global(ul),
  .example-document :global(ol),
  .example-document :global(ruby) {
    white-space: normal;
  }

  .example-document :global(ruby) {
    ruby-align: center;
  }

  .example-document :global(rt) {
    user-select: none;
    color: var(--sl-color-text-accent);
  }

  .example-document :global(p + p) {
    margin-block-start: 0.5rem;
  }

  .example-document :global([role="heading"]) {
    font-size: 1.25rem;
    font-weight: 700;
  }

  .example-document :global([aria-level="1"]) {
    font-size: 1.75rem;
  }

  .example-document :global([aria-level="2"]) {
    font-size: 1.5rem;
  }

  .example-document :global([aria-level="5"]),
  .example-document :global([aria-level="6"]) {
    font-size: 1rem;
  }

  .example-document :global(blockquote) {
    border-inline-start: 0.25rem solid var(--sl-color-gray-4);
    padding-inline-start: 0.75rem;
    font-style: italic;
  }

  .example-document :global(ul),
  .example-document :global(ol) {
    padding-inline-start: 1.5rem;
  }

  .example-document :global(li[data-task]) {
    list-style: none;
    margin-inline-start: -1.25rem;
  }

  .example-document :global(li[data-task]) {
    position: relative;
    padding-inline-start: 1.55rem;
  }

  .example-document :global(li[data-task] > input) {
    position: absolute;
    inset-inline-start: 0;
    inset-block-start: 0.5em;
    margin: 0;
    min-height: 0;
    width: 1rem;
    height: 1rem;
    accent-color: var(--sl-color-text-accent);
  }

  .example-document :global(.disclosure) {
    margin-block: 0.25rem;
    border-inline-start: 2px solid var(--sl-color-gray-5);
    padding-inline-start: 0.6rem;
  }

  .example-document :global(.disclosure-toggle) {
    margin-inline-end: 0.35rem;
    min-height: 1.5rem;
    padding: 0 0.3rem;
    line-height: 1;
  }

  .example-document :global(hr) {
    margin-block: 0.625rem;
    border: 0;
    border-block-start: 1px solid var(--sl-color-gray-4);
  }

  .example-document :global(pre) {
    overflow-x: auto;
    padding: 0.5rem;
    border-radius: 0.3rem;
    background: var(--sl-color-bg);
    font: 0.875rem/1.5 var(--sl-font-mono);
    white-space: pre;
  }

  .example-document :global([data-syntax="keyword"]) { color: var(--sl-color-red-high); }
  .example-document :global([data-syntax="string"]) { color: var(--sl-color-green-high); }
  .example-document :global([data-syntax="constant"]) { color: var(--sl-color-blue-high); }
  .example-document :global([data-syntax="function"]) { color: var(--sl-color-purple-high); }
  .example-document :global([data-syntax="type"]) { color: var(--sl-color-orange-high); }
  .example-document :global([data-syntax="comment"]) { color: var(--sl-color-gray-3); }

  .example-document :global(table) {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  .example-document :global(td),
  .example-document :global(th) {
    height: 2rem;
    border: 1px solid var(--sl-color-gray-4);
  }

  .example-document :global(th) {
    background: var(--sl-color-accent-low);
  }

  .example-document :global(img),
  .example-document :global(audio) {
    max-width: 100%;
  }

  .example-document :global(img) {
    display: block;
    height: auto;
  }

  .example-document :global(summary) {
    cursor: pointer;
  }

  .example-document :global(.remote-caret) {
    display: inline-block;
    position: relative;
    height: 1em;
    border-inline-start: 2px solid var(--sl-color-text-accent);
    vertical-align: text-bottom;
  }

  .example-document :global(.remote-caret > span) {
    position: absolute;
    inset-block-start: -1.35em;
    inset-inline-start: -2px;
    border-radius: 0.2rem;
    padding-inline: 0.25rem;
    background: var(--sl-color-text-accent);
    color: var(--sl-color-black);
    font-size: 0.72rem;
  }

  .example-document:has(:global(.remote-caret)) {
    padding-block-start: 1.5rem;
  }

  .example-document :global(a) {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
  }

  dl {
    display: grid;
    grid-template-columns: minmax(0, max-content) minmax(0, 1fr);
    gap: 0.25rem 0.75rem;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  dt {
    font-weight: 600;
    color: var(--sl-color-white);
  }

  dd {
    margin: 0;
    white-space: pre-wrap;
  }

  @media (max-width: 30rem) {
    .plugin-documents {
      grid-template-columns: minmax(0, 1fr);
    }

    .editor-column + .editor-column {
      border-inline-start: 0;
      border-block-start: 1px solid var(--sl-color-gray-5);
    }

    dl {
      grid-template-columns: minmax(0, 1fr);
    }

    dd + dt {
      margin-block-start: 0.3rem;
    }
  }
</style>
