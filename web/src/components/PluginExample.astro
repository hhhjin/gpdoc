---
import { pluginExamples } from "../plugin-example-config";

interface Props {
  plugin: keyof typeof pluginExamples;
}

const { plugin } = Astro.props;
const { hint, ...example } = pluginExamples[plugin];
---

<iframe class="not-content" src={`${import.meta.env.BASE_URL}playground/`}
  data-plugin-example={plugin} data-config={JSON.stringify(example)}
  title={`${plugin} editor example`} aria-description={hint}></iframe>

<style>
  iframe {
    display: block;
    width: 100%;
    height: 22rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.875rem;
  }
</style>
