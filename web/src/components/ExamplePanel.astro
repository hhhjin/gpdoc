---
interface Props {
  kind: "format" | "json";
  title: string;
  hint: string;
}

const { kind, title, hint } = Astro.props;
---

<form class="example not-content" data-doc-example={kind} aria-label={title}>
  <fieldset disabled>
    <div class="example-header">
      <div>
        <p class="example-title">{title}</p>
        <p class="example-hint">{hint}</p>
      </div>
      <button class="example-reset" type="button" data-reset>Reset</button>
    </div>
    <div class="example-body">
      <slot />
    </div>
  </fieldset>
  <p class="example-status" role="status" data-status>Loading example…</p>
  <noscript><p class="example-status">Enable JavaScript to run this example.</p></noscript>
</form>

<script>
  import "../scripts/docs-examples";
</script>

<style>
  .example {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.875rem;
    overflow: hidden;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }

  fieldset {
    min-inline-size: 0;
    margin: 0;
    border: 0;
    padding: 0;
  }

  .example-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1rem 1.125rem;
    border-block-end: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-bg-sidebar);
  }

  .example-title {
    color: var(--sl-color-white);
    font-weight: 650;
  }

  .example-hint {
    margin-block-start: 0.175rem;
    font-size: 0.875rem;
  }

  .example-body {
    display: grid;
    gap: 0.875rem;
    padding: 1rem 1.125rem;
  }

  .example-status {
    border-block-start: 1px solid var(--sl-color-gray-5);
    padding: 0.55rem 1.125rem;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-2);
    overflow-wrap: anywhere;
  }

  .example-status:empty {
    border-width: 0;
    padding-block: 0;
  }

  .example-status[data-error] {
    color: var(--sl-color-red-high);
  }

  .example:has(noscript .example-status) > [data-status] {
    display: none;
  }

  .example :global(.example-controls) {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.5rem;
  }

  .example :global(.example-label:not([hidden])) {
    display: grid;
    gap: 0.3rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--sl-color-white);
  }

  .example :global(:is(button, input, select, textarea)) {
    min-height: 2.5rem;
    max-width: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4375rem;
    padding: 0.35rem 0.625rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-white);
    font: inherit;
    font-size: 0.875rem;
    font-weight: 400;
  }

  .example :global(button) {
    cursor: pointer;
    font-weight: 600;
  }

  .example :global(button:not(:disabled):hover) {
    border-color: var(--sl-color-text-accent);
  }

  .example :global(button:disabled) {
    opacity: 0.55;
    cursor: default;
  }

  .example :global(button:is([type=submit], [aria-pressed=true])) {
    background: var(--sl-color-text-accent);
    border-color: var(--sl-color-text-accent);
    color: var(--sl-color-black);
  }

  .example :global(button[type=submit]:not(:disabled):hover) {
    background: var(--sl-color-white);
    border-color: var(--sl-color-white);
  }

  .example :global(.example-document) {
    display: block;
    min-height: 4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4375rem;
    padding: 0.95rem 0.875rem;
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-white);
    font-size: 1.125rem;
    font-weight: 400;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .example :global(mark) {
    padding-block: 0.125em;
    border-radius: 0.2em;
    background: var(--sl-color-accent-low);
    color: inherit;
  }

  @media (max-width: 30rem) {
    .example-header,
    .example-body,
    .example-status {
      padding-inline: 0.75rem;
    }
  }
</style>
