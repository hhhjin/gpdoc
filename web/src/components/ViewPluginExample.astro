---
interface Props {
  plugin: string;
  title: string;
}
const { plugin, title } = Astro.props;
---
<iframe
  src={`${import.meta.env.BASE_URL}playground/`}
  title={title}
  data-view-example={plugin}
  class:list={[{ tall: plugin === "slash-command" }]}
></iframe>

<style>
  iframe {
    display: block;
    width: 100%;
    height: 11rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.875rem;
  }
  iframe.tall { height: 17rem; }
</style>
