{
  "name": "gpdoc-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "scripts": {
    "wasm": "bun build-wasm.mjs",
    "dev": "bun run wasm && bun --bun astro dev",
    "build": "bun run wasm && bun --bun astro build",
    "preview": "wrangler dev",
    "deploy": "bun run build && wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.0",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.13",
    "starlight-theme-black": "0.7.1",
    "wrangler": "4.165.0"
  }
}
